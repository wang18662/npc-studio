{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://npc-studio.local/schema/npc.schema.json",
  "title": "NPC Configuration",
  "type": "object",
  "required": ["schemaVersion", "npcId", "name"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "not": { "required": ["extends"] } },
      "then": { "required": ["layers"] }
    }
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "npcId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "extends": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "overrides": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "attributes": {
      "type": "object",
      "description": "NPC 全局属性（如 hp/atk），与状态内的 params 区分",
      "additionalProperties": {
        "type": ["number", "string", "boolean"]
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "locomotion": { "$ref": "#/definitions/layer" },
        "interaction": { "$ref": "#/definitions/layer" },
        "combat": { "$ref": "#/definitions/layer" }
      }
    },
    "ai": { "$ref": "#/definitions/ai" },
    "meta": { "type": "object" }
  },
  "definitions": {
    "layer": {
      "type": "object",
      "required": ["initialState", "states"],
      "additionalProperties": false,
      "properties": {
        "initialState": { "type": "string" },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/state" }
        }
      }
    },
    "state": {
      "type": "object",
      "required": ["id", "name", "archetype", "transitions"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^s_[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "archetype": {
          "type": "string",
          "enum": ["idle", "movement", "perception", "combat", "interaction", "special"]
        },
        "requires": {
          "type": "array",
          "items": { "type": "string" }
        },
        "locks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "params": { "type": "object" },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/definitions/transition" }
        },
        "terminal": {
          "type": "boolean",
          "description": "是否为终止状态。为 true 时允许没有出口转移"
        },
        "priority": {
          "type": "integer",
          "description": "抢占优先级，数值大者可夺取低优先级状态占用的能力，默认 0"
        },
        "behaviorTree": {
          "oneOf": [
            { "$ref": "#/definitions/btNode" },
            { "type": "null" }
          ]
        },
        "onEnter": {
          "type": "array",
          "items": { "type": "string" }
        },
        "onExit": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "transition": {
      "type": "object",
      "required": ["to", "priority", "condition"],
      "additionalProperties": false,
      "properties": {
        "to": { "type": "string" },
        "priority": { "type": "integer" },
        "condition": { "type": "string", "minLength": 1 },
        "cooldown": { "type": "number", "minimum": 0 },
        "interruptible": { "type": "boolean" },
        "emit": {
          "type": "string",
          "description": "转移成功时发出的事件名，供其他层监听（用于跨层协作）"
        }
      }
    },
    "btNode": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["selector", "sequence", "condition", "action"]
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/btNode" }
        },
        "expr": { "type": "string" },
        "name": { "type": "string" },
        "params": { "type": "object" }
      }
    },
    "ai": {
      "type": "object",
      "required": ["enabled", "model", "intents"],
      "properties": {
        "enabled": { "type": "boolean" },
        "model": { "type": "string" },
        "maxTurns": { "type": "integer", "minimum": 1 },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "intents": {
          "type": "array",
          "items": { "$ref": "#/definitions/intent" }
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/definitions/tool" }
        },
        "knowledgeBase": { "type": "string" }
      }
    },
    "intent": {
      "type": "object",
      "required": ["id", "name", "examples", "fallback"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "examples": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "knowledgeRefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fallback": { "type": "string" },
        "allowedTools": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "enabled"],
      "properties": {
        "name": { "type": "string" },
        "enabled": { "type": "boolean" },
        "preconditions": {
          "type": "object",
          "properties": {
            "requiredStates": {
              "type": "array",
              "items": { "type": "string" }
            },
            "requiredCapabilities": {
              "type": "array",
              "items": { "type": "string" }
            },
            "requiredFlags": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
